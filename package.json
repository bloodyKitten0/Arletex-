{
  "name": "arletex-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "arle": "./scripts/run-arletex.sh",
    "build": "pnpm --filter \"@arletex/*\" run build",
    "typecheck": "pnpm --filter \"@arletex/*\" run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "pnpm --filter @arletex/desktop dev",
    "start": "pnpm --filter @arletex/desktop start",
    "clean": "pnpm -r --parallel exec rimraf dist out node_modules"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^22.13.1",
    "rimraf": "^6.0.1",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
